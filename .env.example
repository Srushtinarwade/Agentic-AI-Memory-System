# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local PostgreSQL with pgvector; URL-encode reserved password characters.
POSTGRES_USER=memory
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=memory
POSTGRES_DSN=postgresql://memory:change-this-local-password@127.0.0.1:5432/memory
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10

# Optional Redis cache (NOT the source of truth or a second checkpoint saver).
# To enable: docker compose --profile redis up -d ; set REDIS_URL below.
REDIS_URL=
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL_SECONDS=60

EMBEDDING_MODEL_PATH=models/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
ENTITY_SIMILARITY_FLOOR=0.78
FACT_SIMILARITY_FLOOR=0.68
MAX_FACTS_PER_MESSAGE=15

# Optional laptop-wide X-API-Key (not per-user authentication).
AUTH_TOKEN=
