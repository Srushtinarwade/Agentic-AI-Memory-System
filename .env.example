# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Currently listed on Google's free tier; quotas and availability vary.
GEMINI_MODEL=gemini-3.5-flash-lite

# Local Neo4j container, or Neo4j Desktop (2026.02+)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-local-password
NEO4J_DATABASE=neo4j

# The model is downloaded ONCE and then loaded strictly from disk, on CPU.
EMBEDDING_MODEL_PATH=models/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
ENTITY_SIMILARITY_FLOOR=0.78
FACT_SIMILARITY_FLOOR=0.68
MAX_FACTS_PER_MESSAGE=15
STARTUP_INDEX_WAIT_SECONDS=90

# Optional laptop-wide X-API-Key. Does not provide per-user authentication.
AUTH_TOKEN=
